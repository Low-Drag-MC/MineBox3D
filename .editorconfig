# Editors' settings, matching what ./gradlew spotlessApply writes (palantir-java-format, native/.clang-format).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
max_line_length = 120

[native/src/*.{c,h}]
indent_style = tab
tab_width = 4
max_line_length = 120

[*.{gradle,json,toml,yml,yaml}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
