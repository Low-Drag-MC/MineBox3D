#!/bin/sh
# Fails the commit when a staged Java or bridge C file is not formatted. Fix with: ./gradlew spotlessApply
# Installed by ./gradlew mb3Setup (core.hooksPath). Checks the working-tree copy of each staged file.

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.java' 'native/src/*.c' 'native/src/*.h' | paste -sd, -)
[ -z "$files" ] && exit 0

if ! ./gradlew spotlessCheck -q "-PformatFiles=$files"; then
    echo "pre-commit: staged files are not formatted. Run ./gradlew spotlessApply, stage, and commit again." >&2
    exit 1
fi
